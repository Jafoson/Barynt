{
  "name": "issue-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "postinstall": "bun run scripts/fix-turbopack-bun-externals.ts",
    "format": "biome format --write",
    "db:up": "docker compose up -d --wait && bun prisma generate && bun prisma migrate deploy",
    "db:dev": "docker compose up -d --wait && bun prisma generate && bun prisma migrate deploy && bun prisma db seed",
    "db:seed": "bun prisma db seed",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && bun prisma generate && bun prisma migrate deploy && bun prisma db seed",
    "db:logs": "docker compose logs -f postgres",
    "test": "bun run scripts/run-tests.ts",
    "test:watch": "bun test --watch tests/",
    "test:coverage": "bun run scripts/run-tests.ts --coverage"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@floating-ui/dom": "^1.8.0",
    "@iconify/react": "^6.0.2",
    "@modelcontextprotocol/server": "^2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.2",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "highlight.js": "^11.11.1",
    "ioredis": "^6.0.0",
    "ldapts": "^9.0.0",
    "lowlight": "^3.3.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.101.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
