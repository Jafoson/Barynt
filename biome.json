{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!deploy",
      "!**/*.svg",
      "!lib/icons/bundle.generated.ts",
      "!docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/components/ui/layout/Table/Table.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noRedundantRoles": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.scss"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnknownPseudoClass": "off",
            "noUnknownUnit": "off"
          },
          "suspicious": {
            "noDuplicateProperties": "off"
          }
        }
      }
    }
  ]
}
