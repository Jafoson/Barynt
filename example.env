# Local development — matches docker-compose.yml (orbit-postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/IssueTracker"

# Rate-limit counters for the public API (`lib/api/rateLimit.ts`) — matches
# docker-compose.yml (orbit-redis).
REDIS_URL="redis://localhost:6379"

# --- Docker Compose only (docker-compose.yml) ---------------------------
# These configure the *bundled* `postgres` service and published ports —
# they're read by docker-compose.yml itself, not by the app. Unused for
# plain `bun run dev`. Defaults reproduce today's local-dev container
# (postgres/postgres/IssueTracker) unchanged; for `docker compose --profile
# app up` on a real server, at least set POSTGRES_PASSWORD to something
# that isn't the literal word "postgres".
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="postgres"
# POSTGRES_DB="IssueTracker"
# DB_PORT="5432"
# REDIS_PORT="6379"
# APP_PORT="3000"
# Points `app`/`migrate` at an external Postgres instead of the bundled
# `postgres` service (which you can then leave unused). Full connection
# string, e.g. "postgresql://user:pass@db.example.com:5432/barynt" — not
# the same as DATABASE_URL above, which is for the host-run dev server.
# COMPOSE_DATABASE_URL=""
# Published ports for the bundled RustFS (S3-compatible object storage)
# service: S3 API and web console.
# S3_PORT="9000"
# S3_CONSOLE_PORT="9001"
# Points the app at a real S3 (or other S3-compatible provider) instead of
# the bundled RustFS. Same reasoning as COMPOSE_DATABASE_URL — S3_ENDPOINT
# below is for the host-run dev server ("@localhost:9000").
# COMPOSE_S3_ENDPOINT=""
# Public domain for the bundled Caddy reverse proxy (Caddyfile) — set to a
# real, publicly resolvable domain pointed at this host to get an
# automatic Let's Encrypt certificate. Set AUTH_URL above to
# "https://<same domain>" alongside it, so invitation links etc. point at
# the right place instead of localhost. Left unset, Caddy defaults to
# "localhost" and still serves HTTPS, just with its own internal,
# self-signed CA instead of Let's Encrypt (browsers will warn — expected
# for local/loopback testing, not a real deployment).
# DOMAIN="issues.example.com"
# Postgres/RustFS/the app itself publish to 127.0.0.1 by default (not
# 0.0.0.0) — only `caddy` (80/443) is meant to be reachable from outside
# this host. Override one of these to "0.0.0.0" only if you specifically
# need e.g. a DB client on another machine to reach it directly, ideally
# behind your own firewall rule.
# DB_BIND="127.0.0.1"
# S3_BIND="127.0.0.1"
# APP_BIND="127.0.0.1"

# Base URL of the application. Auth.js uses it for callbacks, `lib/invitations.ts`
# for the copyable invitation link. Locally the fallback is enough
# (http://localhost:3000); in production it's required, otherwise the links
# point at localhost.
# AUTH_URL=https://issues.example.com

# Auth.js — required. Generate a random value with: bunx auth secret
AUTH_SECRET="dev-secret-minimum-32-characters-long!"

# No password login anymore. Passkeys (WebAuthn) run by default with no
# configuration — everything below this is optional and purely additive. Two
# opt-outs, both on by default, only the literal "false" turns them off:
#
# AUTH_PASSKEY_LOGIN_ENABLED="false"        # Passkeys completely off (login,
#                                            # registration, "Add passkey" in
#                                            # your own settings). WARNING:
#                                            # without an OAuth provider and
#                                            # without SMTP further down,
#                                            # nobody can get into the system
#                                            # anymore — not even for the
#                                            # very first account.
# AUTH_PASSKEY_REGISTRATION_ENABLED="false" # Only new accounts via passkey off
#                                            # (the "Register with passkey"
#                                            # button on /login). Existing
#                                            # accounts can still sign in via
#                                            # passkey and add further passkeys
#                                            # in their own settings.

# Optional OAuth providers.
# GitHub:  https://github.com/settings/developers
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# Google:  https://console.cloud.google.com/apis/credentials
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# GitLab:  https://gitlab.com/-/user_settings/applications (or the
#          applications page of a self-hosted instance)
# AUTH_GITLAB_ID=""
# AUTH_GITLAB_SECRET=""
# Microsoft Entra ID (Azure AD): https://portal.azure.com — app registration
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Without ISSUER, any Microsoft account may sign in (personal, school,
# work). To restrict to your own tenant only: set the Directory (tenant) ID.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Apple: https://developer.apple.com/account/resources/identifiers — needs
# a paid Apple Developer membership, only works over HTTPS (no localhost),
# and the secret is a self-signed JWT instead of a fixed string.
# `npx auth add apple` asks for everything interactively and writes both
# values here itself.
# AUTH_APPLE_ID=""
# AUTH_APPLE_SECRET=""

# A generic OIDC provider (Keycloak, Authentik, Entra ID, Okta, ...).
# AUTH_OIDC_NAME is just the button's label (defaults to "SSO").
# AUTH_OIDC_ISSUER="https://idp.example.com"
# AUTH_OIDC_CLIENT_ID=""
# AUTH_OIDC_CLIENT_SECRET=""
# AUTH_OIDC_NAME="Company SSO"

# SMTP — optional, but the only way an already-existing account without a
# passkey (e.g. an open invitation) can ever sign in: a passkey can only be
# registered for an already-existing address with an active session
# (next-auth otherwise refuses it as `AccountNotLinked`), a magic link
# can't — clicking the link is the proof that the address belongs to the
# person. Without SMTP_HOST the app sends no mail at all (see `lib/mail`);
# invitation links and notifications then stay purely in-app/for copying, as
# without this section — but invitations can then no longer be accepted.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="user@example.com"
# SMTP_PASS="..."
# Sender address in the `From` header. Without one: "Issue Tracker <no-reply@$SMTP_HOST>".
# SMTP_FROM="Issue Tracker <no-reply@example.com>"

# Name/address in the footer of every email (many providers expect a
# physical address in commercial mail). Without one, the line is simply left
# out instead of showing a made-up address.
# MAIL_COMPANY_NAME="Your Company Inc."
# MAIL_COMPANY_ADDRESS="123 Main St, 12345 City"

# S3-compatible object storage (`lib/storage`) — for avatars (user/workspace)
# and issue attachments (images, files, videos). Works with AWS S3 just as
# well as any other S3-compatible provider (rustfs, MinIO, ...). Without
# S3_ENDPOINT, both upload paths stay off; the app keeps running with plain
# initial-based avatars and no attachments. Both buckets are independent of
# each other: S3_BUCKET_AVATARS without S3_BUCKET_ISSUES lets avatar upload
# work while attachments stay off (and vice versa). Both buckets must be
# private — read access goes through server-side signed, time-limited URLs.
# Addressing is always path-style (<endpoint>/<bucket>/<key>) — works for
# rustfs, MinIO, and AWS S3 alike. Locally: rustfs at
# http://localhost:9000. For AWS S3: set S3_ENDPOINT to the regional
# endpoint, e.g. "https://s3.eu-central-1.amazonaws.com".
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_AVATARS="avatars"
# S3_BUCKET_ISSUES="issues"
