# Reverse proxy for the self-hosted stack (docker-compose.yml, "caddy"
# service). DOMAIN comes from .env — see example.env.
#
# A real, publicly resolvable domain (e.g. "issues.example.com") makes
# Caddy fetch and auto-renew a Let's Encrypt certificate for it, no
# further config needed. Left unset, it defaults to "localhost", for which
# Caddy still serves HTTPS (with automatic HTTP->HTTPS redirects) — just
# using its own internal, self-signed CA instead of Let's Encrypt, since
# "localhost" can never pass public domain validation. Browsers will warn
# about that certificate; that's expected for local/loopback testing.
{$DOMAIN:localhost} {
	reverse_proxy app:3000
}

# File storage (bundled RustFS): avatars and attachments are uploaded and
# downloaded by the browser directly, through presigned URLs. Those carry a
# signature over host and path, so they need a host of their own rather
# than a path under DOMAIN — FILES_DOMAIN, e.g. "files.issues.example.com",
# with S3_PUBLIC_ENDPOINT (COMPOSE_S3_PUBLIC_ENDPOINT in .env) pointing at
# it. The installer sets both. Caddy passes the Host header through
# unchanged, which is what RustFS checks the signature against. Unused (and
# harmless) on a local setup, which reaches RustFS on its own port instead.
{$FILES_DOMAIN:files.localhost} {
	reverse_proxy rustfs:9000
}
