# Reverse proxy for the self-hosted stack (docker-compose.yml, "caddy"
# service). DOMAIN comes from .env — see example.env.
#
# A real, publicly resolvable domain (e.g. "issues.example.com") makes
# Caddy fetch and auto-renew a Let's Encrypt certificate for it, no
# further config needed. Left unset, it defaults to "localhost", for which
# Caddy still serves HTTPS (with automatic HTTP->HTTPS redirects) — just
# using its own internal, self-signed CA instead of Let's Encrypt, since
# "localhost" can never pass public domain validation. Browsers will warn
# about that certificate; that's expected for local/loopback testing.
{$DOMAIN:localhost} {
	# `flush_interval -1` flushes every write immediately instead of
	# buffering. Without it, live-update Server-Sent Events
	# (/api/workspaces/[id]/updates, BARY-26) can sit in Caddy's buffer
	# indefinitely — the app's own dev server (no proxy in front) never
	# showed this, only the deployed stack behind Caddy did.
	reverse_proxy app:3000 {
		flush_interval -1
	}
}
