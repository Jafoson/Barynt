# public/Barynt_Logo.af~lock~:com.dropbox.ignored ended up committed by
# accident while someone had the design file open with Dropbox syncing it)
*~lock~
*:com.dropbox.ignored
.dropbox
.dropbox.cache
Thumbs.db
desktop.ini
.directory
*.swp
*.swo
.Spotlight-V100
.Trashes

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated
