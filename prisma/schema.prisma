generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── RBAC-Enums ───────────────────────────────────────────────────────────────

/// Wo eine Rolle vergeben werden kann. Ein Permission-Key nennt nur Objekt und
/// Aktion (`issue.create`) — der Scope der Rolle sagt, worauf sie wirkt.
enum RoleScope {
  PLATFORM
  WORKSPACE
  PROJECT
}

/// Wer beim Anlegen und beim Beitritt automatisch ins Projekt eingetragen wird.
/// Über den Zugriff selbst entscheidet allein `ProjectMember` — ein privates
/// Projekt hat nur die, die ausdrücklich aufgenommen wurden.
enum ProjectVisibility {
  public
  private
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id
  name      String
  slug      String   @unique
  color     String   @default("#6e63e6")
  // Plattform-Ebene: ein Workspace = ein Tenant. `suspended` deaktiviert den
  // Zugriff ohne Löschen (vom Plattform-Admin gesetzt).
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
  /// Wozu der Workspace da ist, in ein bis zwei Sätzen. Steht im Steckbrief
  /// unter dem Namen; leer heißt, dass es niemand gesagt hat.
  desc      String   @default("")
  /// Objektschlüssel im `avatars`-Bucket (`lib/storage`) für ein selbst
  /// hochgeladenes Bild. Ohne S3-Konfiguration oder ohne Upload bleibt es
  /// beim Initialen-Avatar.
  avatarKey String?

  members       WorkspaceMember[]
  projects      Project[]
  labels        Label[]
  teams         Team[]
  invitations   Invitation[]
  statuses      WorkspaceStatus[]
  priorities    WorkspacePriority[]
  issueTypes    WorkspaceIssueType[]
  roles         Role[]
  // Wie einzelne Personen das Dashboard dieses Workspace eingerichtet haben.
  dashboards    WorkspaceDashboardPreference[]
  // Wie einzelne Personen Board/Liste der projektübergreifenden "Meine
  // Issues"-Ansicht eingerichtet haben (BARY-33).
  myIssuesViewPreferences MyIssuesViewPreference[]
  // Wichtige externe Adressen — Dokumentation, Repository, Chat.
  links         WorkspaceLink[]
  notifications Notification[]
  domains       WorkspaceDomain[]
  inviteLinks   InviteLink[]
  webhooks      Webhook[]
  // Zeigt hierher, wenn dieser Workspace als globaler Default eingetragen ist
  // (SystemSettings.defaultWorkspaceId) — siehe dort.
  defaultForSystemSettings SystemSettings[]
  // Welche der installierten Plugins hier eingeschaltet sind, samt Einstellungen.
  plugins       PluginWorkspace[]
}

/// Eine E-Mail-Domain, über die neue Konten automatisch in diesen Workspace
/// aufgenommen werden (`register()`, `features/auth/actions.ts`).
///
/// `domain` ist der Primärschlüssel statt eines gewöhnlichen Felds mit
/// `@@unique`: eine Domain gehört exklusiv zu höchstens einem Workspace, sonst
/// könnte ein zweiter Workspace dieselbe Domain beanspruchen und Leute abgreifen,
/// die eigentlich dem ersten beitreten wollten. Bekannte Freemail-Domains
/// (gmail.com und ähnliche) lehnt `addWorkspaceDomain()` schon beim Anlegen ab —
/// die Exklusivität hier schützt nur vor zwei Workspaces, nicht vor einem
/// einzelnen, der sich versehentlich (oder absichtlich) eine öffentliche
/// Domain aneignet.
model WorkspaceDomain {
  /// Normalisiert: klein geschrieben, ohne führendes "@".
  domain      String   @id
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Eine wichtige externe Adresse eines Workspace — Dokumentation, Repository,
/// Chat, was sonst dazugehört. Steht im Steckbrief als Reihe großer Chips
/// direkt unter der Kopfkarte.
model WorkspaceLink {
  id          String @id
  workspaceId String
  label       String
  url         String
  /// Reihenfolge der Chips. Explizit statt aus der Anlagezeit abgeleitet, weil
  /// sich eine Reihenfolge im Steckbrief per Hand einrichten lassen soll.
  position    Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  // @default(cuid()) ist für den Auth.js-Adapter nötig: dessen createUser strippt
  // die id und überlässt die Generierung der DB. Bestehende Zeilen sind unberührt.
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  handle         String    @unique
  /// Optional: ein Passkey-Konto braucht keine Adresse (siehe `auth.ts`s
  /// WebAuthn-`getUserInfo`). Ohne sie funktionieren weder Magic Link noch
  /// Einladung/Benachrichtigung per Mail für dieses Konto, und es gibt keinen
  /// Recovery-Weg, falls der Passkey verloren geht — die Person kann jederzeit
  /// unter Account → Security eine Adresse nachtragen.
  email          String?   @unique
  color          String
  // Auth.js-Adapter-Felder (OAuth). handle/color werden im createUser-Override gefüllt.
  emailVerified  DateTime?
  image          String?
  /// Objektschlüssel im `avatars`-Bucket (`lib/storage`) für ein selbst
  /// hochgeladenes Bild — getrennt von `image` (roher OAuth-Avatar-Link,
  /// wird von `Avatar.tsx` nicht gerendert).
  avatarKey      String?
  // Rolle im Scope PLATFORM. Steuert Plattform-Operationen und gewährt für sich
  // genommen KEINEN Zugriff auf Mandanteninhalte — dafür braucht die Rolle
  // ausdrücklich `tenant.access`.
  platformRoleId String?
  platformRole   Role?     @relation("UserPlatformRole", fields: [platformRoleId], references: [id], onDelete: SetNull)

  /// Seit wann es das Konto gibt. Die Plattformverwaltung zeigt es an; sonst
  /// interessiert es niemanden.
  createdAt     DateTime  @default(now())
  /// Wann zuletzt ein Lebenszeichen kam. Grob gehalten (siehe `lib/presence.ts`):
  /// die Spalte wird höchstens einmal je Stunde nachgezogen, weil sie sonst bei
  /// jedem Seitenaufruf einen Schreibvorgang kostete.
  lastSeenAt    DateTime?
  /// Gesetzt heißt: stillgelegt. Das Konto bleibt samt allem, was daran hängt,
  /// bekommt aber keinerlei Rechte mehr (`lib/permissions.ts`) und kommt nicht
  /// mehr herein (`auth.ts`). Das Gegenstück zum Löschen, das Issues, Kommentare
  /// und Zuweisungen mitnähme.
  deactivatedAt DateTime?
  /// Ungesetzt heißt: braucht noch den Onboarding-Schritt (Benutzername
  /// bestätigen, Name optional) — geprüft in `app/[locale]/page.tsx`, bevor
  /// die Person einen Workspace anlegt oder betritt. Eingeladene Konten
  /// (Schatten-Zeile beim Einladen, `features/workspaces/actions.ts` /
  /// `features/projects/actions.ts`) setzen es sofort bei der Erstellung —
  /// die Einladung selbst bleibt dadurch reibungslos, ohne Zwischenschritt.
  onboardedAt   DateTime?

  workspaces          WorkspaceMember[]
  assignedIssues      Issue[]                        @relation("IssueAssignee")
  reportedIssues      Issue[]                        @relation("IssueReporter")
  sharedIssues        Issue[]                        @relation("IssueSharedBy")
  comments            Comment[]
  commentReactions    CommentReaction[]
  attachments         Attachment[]
  leadingTeams        Team[]                         @relation("TeamLead")
  teamMemberships     TeamMember[]
  projectMemberships  ProjectMember[]
  createdProjects     Project[]                      @relation("ProjectCreator")
  accounts            Account[]
  sessions            Session[]
  authenticators      Authenticator[]
  invitations         Invitation[]
  invitationsSent     Invitation[]                   @relation("InvitationInvitedBy")
  inviteLinksCreated  InviteLink[]                   @relation("InviteLinkCreatedBy")
  preferences         UserPreferences?
  dashboards          DashboardPreference[]
  workspaceDashboards WorkspaceDashboardPreference[]
  issueViewPreferences   IssueViewPreference[]
  myIssuesViewPreferences MyIssuesViewPreference[]
  notifications       Notification[]                 @relation("NotificationRecipient")
  notificationsCaused Notification[]                 @relation("NotificationActor")
  apiKeys             ApiKey[]
  webhooksCreated     Webhook[]                       @relation("WebhookCreatedBy")
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]
}

/// Ein persönlicher API-Key ("bry_…"-Token) für die öffentliche REST-API
/// (`app/api/v1`). Wirkt bei jeder Rechteprüfung wie die eigene Session — `can()`
/// wird mit `userId` genauso aufgerufen, wie es eine Session auflösen würde
/// (`lib/api-auth.ts`). Ein Key ist ein User Access Token, kein Service-Account:
/// `scopes` kann die eigenen Rechte nur einschränken, nie erweitern — die
/// RBAC-Prüfung entscheidet zusätzlich pro Ressource, genau wie bei einer
/// Session.
model ApiKey {
  id     String @id @default(cuid())
  userId String
  /// Frei gewählt, erscheint in der Liste — "CI-Pipeline", "Zapier" usw.
  name   String
  /// Die ersten ~12 Zeichen des rohen Tokens, im Klartext für die maskierte
  /// Anzeige ("bry_a1b2c3d4…") — der einzige Teil des Secrets, der nach der
  /// Erstellung je wieder sichtbar ist.
  prefix String
  /// SHA-256-Hex-Digest des vollen rohen Tokens. `@unique`, das ist der
  /// Lookup-Schlüssel (`lib/api-auth.ts`) — kein gehärteter Passwort-Hash, das
  /// rohe Token trägt bereits 256 Bit CSPRNG-Entropie.
  tokenHash String   @unique
  /// Granulare Scopes im Jira-Stil ("issues:read", "comments:write", …) statt
  /// eines groben READ/WRITE — die Werte sind die Schlüssel aus
  /// `lib/api/scopes.ts#API_SCOPES`, hier bewusst als freier String statt Enum,
  /// damit ein neuer Scope keine Migration braucht.
  scopes     String[] @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  /// Gesetzt heißt: nicht mehr benutzbar, unabhängig von `expiresAt`.
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ein registrierter OAuth-Client für den MCP-Server (`app/api/mcp`) —
/// entsteht praktisch immer per Dynamic Client Registration (RFC 7591),
/// wenn sich ein MCP-Client wie Claude selbst anmeldet, statt manuell im
/// Admin-Bereich angelegt zu werden. Ausschließlich öffentliche Clients:
/// kein `clientSecret`, PKCE ist im Autorisierungscode-Flow Pflicht
/// (`lib/oauth/`).
model OAuthClient {
  id String @id @default(cuid())
  /// Vom Client selbst angegeben (RFC 7591 `client_name`), z. B. "Claude".
  name String
  /// Exakter Abgleich ist Pflicht (Spec-Vorgabe gegen Open Redirect) —
  /// mehrere erlaubt, für Desktop-Clients mit wechselndem Loopback-Port.
  redirectUris String[]
  createdAt    DateTime @default(now())

  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]
  refreshTokens      OAuthRefreshToken[]
}

/// Kurzlebiger Autorisierungscode zwischen `/oauth/authorize` und
/// `/oauth/token` — einmal verwendbar (`usedAt`), `codeChallenge` bindet
/// ihn an den PKCE-Verifier, den nur der ursprüngliche Client kennt.
model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  /// SHA-256-Hex-Digest des rohen Codes, wie bei `ApiKey.tokenHash`.
  codeHash            String    @unique
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  /// RFC 8707 — die kanonische MCP-Server-URI, an die der spätere Access
  /// Token gebunden wird. Optional, weil nicht jeder Client den Parameter
  /// mitschickt (nur MUST für den Client laut Spec, nicht für den Server,
  /// solche zu verlangen).
  resource  String?
  scopes    String[]  @default([])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

/// Access Token aus dem OAuth-Flow — spielt für `lib/mcp/auth.ts` dieselbe
/// Rolle wie `ApiKey`, nur kurzlebig und vom Client statt vom Nutzer selbst
/// verwaltet.
model OAuthAccessToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  clientId  String
  userId    String
  scopes    String[]  @default([])
  resource  String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  client       OAuthClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken OAuthRefreshToken?

  @@index([userId])
}

/// Rotierender Refresh Token (OAuth-2.1-Pflicht für Public Clients) — jede
/// Einlösung erzeugt ein neues Access/Refresh-Paar und widerruft dieses hier
/// (`revokedAt`); die Wiederverwendung eines bereits eingelösten Tokens
/// widerruft die gesamte Kette (Diebstahl-Erkennung, siehe `lib/oauth/token.ts`).
model OAuthRefreshToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  clientId      String
  userId        String
  scopes        String[]  @default([])
  resource      String?
  accessTokenId String?   @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  client      OAuthClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken OAuthAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Ein Webhook-Endpunkt eines Workspace — schickt eine signierte HTTP-POST-
/// Anfrage bei bestimmten Ereignissen (`lib/webhooks/events.ts`), ausgelöst
/// aus `features/issues/actions.ts` und `features/api-v1/mutations.ts`
/// (`lib/webhooks/deliver.ts#fireWebhookEvent`). Anders als bei `ApiKey`:
/// gehört dem Workspace, nicht einer einzelnen Person — Integrationen wie
/// Slack- oder CI-Benachrichtigungen sind workspaceweite Konfiguration, kein
/// persönliches Zugriffstoken.
model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  /// Klartext, nicht gehasht wie `ApiKey.tokenHash` — wird bei jeder
  /// Zustellung zum Signieren gebraucht (HMAC-SHA256), ist also kein reiner
  /// Lookup-Wert, sondern muss lesbar bleiben.
  secret String
  /// Werte aus `lib/webhooks/events.ts#WEBHOOK_EVENTS`, z.B. "issue.created".
  events  String[]
  enabled Boolean  @default(true)

  createdById String
  createdAt   DateTime @default(now())

  /// Ergebnis des letzten Zustellversuchs — ein Feld statt einer eigenen
  /// Log-Tabelle, weil es (noch) keinen Retry gibt: nur der letzte Versuch
  /// ist überhaupt relevant. `lastDeliveryStatus` ist der HTTP-Status bei
  /// einer erhaltenen Antwort, `lastDeliveryError` der Fehlertext, wenn gar
  /// keine Antwort zustande kam (Timeout, DNS, Verbindung abgelehnt) —
  /// gesetzt wird immer nur genau eines von beiden.
  lastDeliveryAt     DateTime?
  lastDeliveryStatus Int?
  lastDeliveryError  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WebhookCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId])
}

/// Was einer Person gehört und keinem Workspace: wie die Oberfläche aussieht und
/// worüber sie benachrichtigt werden will.
///
/// Eigene Tabelle statt weiterer Spalten an `User`, weil hier nur Vorlieben
/// stehen — nichts davon entscheidet über Zugriff, und `User` wird bei jeder
/// Rechteprüfung gelesen. Die Zeile entsteht erst beim ersten Speichern
/// (`upsert`); wer nie etwas eingestellt hat, hat keine — gelesen wird dann der
/// Satz aus `features/account/queries.ts`, der dieselben Vorgaben trägt wie die
/// `@default`s hier.
model UserPreferences {
  userId String @id

  /// "dark" | "light" | "system" — landet als `data-theme` am Dokument.
  theme String @default("dark")

  /// Der Hinweis im Plattform-Bereich, was dort zu sehen ist und was nicht.
  /// Weggeklickt bleibt weggeklickt — und weil die Seite server-gerendert ist,
  /// steht die Antwort hier und nicht im `localStorage`: sonst zeigte der Server
  /// den Hinweis und der Browser nähme ihn beim Hydrieren wieder weg.
  adminNoticeHidden Boolean @default(false)

  // Benachrichtigungen, je Anlass einmal für die App und einmal für die Mail.
  // Es gibt noch keinen Mailversand; die Spalten stehen trotzdem hier, damit die
  // Wahl schon getroffen werden kann und nicht später nachgeholt werden muss.
  assignedInApp    Boolean @default(true)
  assignedEmail    Boolean @default(true)
  mentionedInApp   Boolean @default(true)
  mentionedEmail   Boolean @default(true)
  commentInApp     Boolean @default(true)
  commentEmail     Boolean @default(false)
  // Antwort auf einen eigenen Kommentar (nicht bloß ein neuer Kommentar am
  // selben Issue) — direkter adressiert als der allgemeine `comment`-Anlass,
  // deshalb wie bei `mentioned` per Default auch per Mail an.
  commentReplyInApp Boolean @default(true)
  commentReplyEmail Boolean @default(true)
  statusInApp      Boolean @default(true)
  statusEmail      Boolean @default(false)
  inviteInApp      Boolean @default(true)
  inviteEmail      Boolean @default(true)
  roleInApp        Boolean @default(true)
  roleEmail        Boolean @default(true)
  issueSharedInApp Boolean @default(true)
  issueSharedEmail Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Das Projekt-Dashboard, wie es einer eingerichtet hat ────────────────────
//
// Eine Zeile je Person **und** Projekt. Das Dashboard gehört keinem Projekt und
// keinem Team, sondern dem, der es ansieht: wer Aufgaben verteilt, will die
// Auslastung oben haben, wer selbst welche abarbeitet, den Rückstand. Beide auf
// dieselbe Anordnung festzulegen hieße, einem von beiden die falsche Seite zu
// zeigen.
//
// Die Zeile entsteht erst, wenn jemand etwas verstellt — wie `UserPreferences`.
// Wer nie etwas anfasst, bekommt die Vorgabe aus `features/dashboard/widgets.ts`,
// und die Oberfläche muss den Unterschied nicht kennen.

model DashboardPreference {
  userId    String
  projectId String

  /// Bausteine, die diese Person ausgeblendet hat — Keys aus `WIDGETS`.
  hidden String[]

  /// Die Reihenfolge, in der die Bausteine stehen. Unvollständig gespeichert:
  /// was hier fehlt, behält seinen Platz aus der Vorgabe. Sonst erschiene ein
  /// später ergänzter Baustein bei niemandem mehr, der einmal etwas verschoben
  /// hat.
  order String[]

  /// Der Zeitraum, mit dem das Dashboard aufgeht — "7d" | "30d" | "90d" | "12m".
  /// Steht auch in der Adresse (`?range=`); hier steht, womit es ohne Angabe
  /// beginnt.
  range String @default("30d")

  /// Welche der beiden Ansichten zuletzt offen war — "profile" | "dashboard".
  ///
  /// Die Projektzeile in der Seitenleiste führt ohne `?view=` auf diese Seite;
  /// wer zuletzt die Zahlen ansah, soll sie beim nächsten Klick wieder sehen und
  /// nicht erst wieder umschalten. Die Vorgabe ist der Steckbrief: er beantwortet
  /// „was ist das hier" und gilt auch für den, der das Projekt zum ersten Mal
  /// öffnet.
  view String @default("profile")

  /// Mit welchem Umfang das Dashboard aufgeht — "all" | "mine". Wer
  /// `dashboard.view.all` nicht trägt, bekommt beim Lesen ohnehin "mine"
  /// erzwungen (siehe `getProjectDashboard`); hier steht nur, womit es für die
  /// aufgeht, die überhaupt wählen dürfen.
  scope String @default("all")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

/// Wie eine Person das Dashboard eines Workspace eingerichtet hat — dasselbe
/// Muster wie `DashboardPreference` eine Ebene tiefer, nur ohne `view`: Dashboard
/// und Übersicht sind beim Workspace zwei eigene Routen mit je einem eigenen
/// Navlink in der Seitenleiste, keine Ansicht, die sich eine Zeile merken muss.
model WorkspaceDashboardPreference {
  userId      String
  workspaceId String

  /// Bausteine, die diese Person ausgeblendet hat — Keys aus `WIDGETS`.
  hidden String[]

  /// Die Reihenfolge, in der die Bausteine stehen. Unvollständig gespeichert,
  /// siehe `DashboardPreference.order`.
  order String[]

  /// Der Zeitraum, mit dem das Dashboard aufgeht — "7d" | "30d" | "90d" | "12m".
  range String @default("30d")

  /// Mit welchem Umfang das Dashboard aufgeht — "all" | "mine". Dasselbe Feld
  /// wie `DashboardPreference.scope` eine Ebene tiefer.
  scope String @default("all")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

/// Wie eine Person Board/Liste eines Projekts eingerichtet hat — Anzeige,
/// Sortierung und Gruppierung (BARY-32/33). `hiddenFields` wirkt zusätzlich zu
/// `Project.hiddenDetailFields` (BARY-31): sichtbar ist ein Feld nur, wenn
/// weder das Projekt noch diese Einstellung es versteckt. Board und Liste
/// führen eigene Zeilen (`view`), analog zu `DashboardPreference` eine Ebene
/// höher.
model IssueViewPreference {
  userId    String
  projectId String
  /// "board" | "list".
  view      String

  /// Karten-/Zeilenfelder, die diese Person ausgeblendet hat — Keys aus
  /// `CARD_FIELD_KEYS` (`features/issues/card-fields.ts`).
  hiddenFields String[] @default([])

  /// Gruppen (Board-Spalten / Listengruppen), die diese Person ausgeblendet
  /// hat — Einträge "<groupKey>:<groupId>", damit ein Wechsel der Gruppierung
  /// nichts Falsches trifft (`features/issues/hidden-groups.ts`, BARY-47).
  hiddenGroups String[] @default([])
  /// Leere Gruppen automatisch ausblenden (BARY-47).
  hideEmptyGroups Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId, view])
  @@index([projectId])
}

/// Dasselbe wie `IssueViewPreference`, aber für die projektübergreifende
/// "Meine Issues"-Ansicht (`/my`, `/my/list`) — dort gibt es kein einzelnes
/// Projekt, an das sich die Einstellung hängen ließe, sondern nur den
/// Workspace. Gleiches Muster wie `WorkspaceDashboardPreference` neben
/// `DashboardPreference`.
model MyIssuesViewPreference {
  userId      String
  workspaceId String
  /// "board" | "list".
  view        String

  hiddenFields String[] @default([])
  hiddenGroups String[] @default([])
  /// Leere Gruppen automatisch ausblenden (BARY-47).
  hideEmptyGroups Boolean @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId, view])
  @@index([workspaceId])
}

// ─── Auth.js (NextAuth) ─────────────────────────────────────────────────────────
// Standard-Adapter-Modelle. Session bleibt bei JWT-Strategie ungenutzt, wird aber
// vom PrismaAdapter typseitig erwartet.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Passkeys (WebAuthn). Feldnamen/-typen sind vom PrismaAdapter vorgegeben —
// er reicht die Objekte unverändert durch, `credentialID` muss deshalb
// eigenständig `@unique` sein (der Adapter sucht ausschließlich darüber).
model Authenticator {
  credentialID         String   @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  // Nicht Teil des Adapter-Vertrags (der reicht nur die sieben Felder oben
  // durch) — reiner Anzeige-Zeitpunkt für die Kontoeinstellungen, entsteht
  // aus dem Spalten-Default statt aus der Ceremony.
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  // Rolle auf der Workspace-Ebene (Role.scope = WORKSPACE, gleicher Workspace).
  roleId      String
  pending     Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: eine Rolle, die noch jemand trägt, lässt sich nicht löschen.
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId])
  @@index([roleId])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id           String            @id
  workspaceId  String
  name         String
  slug         String
  prefix       String
  color        String
  /// Wozu das Projekt da ist, in einem Satz. Steht in der Projektübersicht
  /// neben dem Namen; leer heißt schlicht, dass es niemand gesagt hat.
  desc         String            @default("")
  lastIssueKey Int               @default(0)
  visibility   ProjectVisibility @default(public)
  /// Objektschlüssel im `avatars`-Bucket (`lib/storage`) für ein selbst
  /// hochgeladenes Bild. Ohne S3-Konfiguration oder ohne Upload bleibt es
  /// beim Initialen-Avatar.
  avatarKey    String?
  /// Welche Felder der Issue-Detailansicht in diesem Projekt ausgeblendet
  /// sind (BARY-31) — Keys aus `DETAIL_FIELD_KEYS`
  /// (`features/projects/detail-fields.ts`). Nur die *ausgeblendeten*
  /// gespeichert (nicht die sichtbaren): neu hinzukommende Felder landen so
  /// automatisch bei "sichtbar", ohne dass alte Projekt-Zeilen nachgezogen
  /// werden müssten — dieselbe Überlegung wie bei `DashboardPreference.hidden`.
  /// `description` darf hier nie auftauchen (in der Server Action gefiltert);
  /// alle anderen Keys sind für neue Projekte per Default schon enthalten
  /// (`DEFAULT_HIDDEN_DETAIL_FIELDS`), nicht per Spalten-Default hier.
  hiddenDetailFields String[] @default([])

  /// Wann es angelegt wurde.
  createdAt   DateTime  @default(now())
  /// Gesetzt heißt: stillgelegt. Das Projekt bleibt lesbar, aber es ist erkennbar
  /// aus dem Betrieb — die Plattformverwaltung findet daran verwaiste Projekte.
  archivedAt  DateTime?
  /// Wer es angelegt hat. `SetNull`, weil ein gelöschtes Konto das Projekt nicht
  /// mitnehmen darf — genau dann wird das Projekt zum Waisen, den die
  /// Plattformverwaltung neu zuordnen muss.
  createdById String?
  createdBy   User?     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues        Issue[]
  teams         TeamProject[]
  labels        Label[]
  members       ProjectMember[]
  invitations   Invitation[]
  // Workspace-Labels, die in diesem Projekt nicht angeboten werden.
  hiddenLabels  ProjectHiddenLabel[]
  // Projektlokale Rollen (Role.scope = PROJECT mit gesetztem projectId).
  roles         Role[]
  // Wie einzelne Personen das Dashboard dieses Projekts eingerichtet haben.
  dashboards    DashboardPreference[]
  // Wie einzelne Personen Board/Liste dieses Projekts eingerichtet haben
  // (BARY-33) — welche Kartenfelder sie zusätzlich zu Project.hiddenDetailFields
  // ausgeblendet haben.
  issueViewPreferences IssueViewPreference[]
  notifications Notification[]
  inviteLinks   InviteLink[]

  @@unique([workspaceId, prefix])
  @@unique([workspaceId, slug])
}

// ─── Project membership (wer im Projekt ist, mit welcher Rolle) ───────────────
//
// Eine Zeile je Person und Projekt, für **jeden**, der im Projekt ist — das
// Gegenstück zu `WorkspaceMember` eine Ebene tiefer. Wer im Workspace ist, wird
// in dessen öffentlichen Projekten mit einer passenden Projektrolle eingetragen
// (lib/project-membership.ts). Danach ist diese Rolle unabhängig: sie gilt in
// genau diesem Projekt und lässt sich dort ändern, ohne den Workspace anzufassen.
//
// Diese Tabelle ist die Zugriffsentscheidung für alles Projektbezogene: keine
// Zeile heißt kein Zugriff (lib/permissions.ts). `Project.visibility` steuert
// deshalb nur noch, wer beim Anlegen automatisch eingetragen wird.

/// Woher die Rolle einer `ProjectMember`-Zeile stammt.
///
/// `manual` heißt: ein Projektleiter hat sie ausdrücklich gesetzt (per
/// Mitgliederliste oder Einladung) — oder sie ist die Standardrolle aus der
/// Workspace-Aufnahme (`lib/project-membership.ts`). `team` heißt: sie kommt
/// aus einem Team, das mit einer Rolle an diesem Projekt hängt. Der
/// Unterschied entscheidet, wer eine Zeile beim Nachziehen der Team-Rollen
/// anfassen darf — eine `manual`-Zeile fasst `syncProjectTeamRoles` nie an.
enum ProjectMemberOrigin {
  manual
  team
}

model ProjectMember {
  projectId String
  userId    String
  // Rolle auf der Projekt-Ebene (Role.scope = PROJECT). Entweder eine
  // workspaceweite Projektrolle oder eine projektlokale. Sie ist in diesem
  // Projekt die ganze Wahrheit: was hier nicht steht, gilt hier nicht. Die
  // Workspace-Rolle greift nur über `project.admin.all` durch.
  roleId    String

  /// Siehe `ProjectMemberOrigin`. Default `manual`, damit jede bestehende und
  /// jede von Hand gesetzte Zeile unangetastet bleibt.
  origin       ProjectMemberOrigin @default(manual)
  /// Nur bei `origin = team` gesetzt: welches Team diese Rolle zuletzt
  /// begründet hat — reine Anzeige ("via Team X"). `SetNull`, weil das Team
  /// verschwinden kann, ohne dass die (dann verwaiste) Zeile mitgerissen wird;
  /// der nächste Sync räumt sie ohnehin auf.
  originTeamId String?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  originTeam Team?   @relation(fields: [originTeamId], references: [id], onDelete: SetNull)

  @@id([projectId, userId])
  @@index([userId])
  @@index([roleId])
  @@index([originTeamId])
}

// ─── Einladungen ──────────────────────────────────────────────────────────────
//
// Wer per E-Mail eingeladen wird, bekommt sofort ein Konto — ohne Passwort und
// mit `WorkspaceMember.pending = true`. Diese Zeile ist der Weg von dort zum
// fertigen Zugang: `token` ist der Einladungslink, und angenommen wird er genau
// einmal (`acceptedAt`). Beim Annehmen entstehen Passwort und Name, `pending`
// fällt weg, und die Projektmitgliedschaften werden nachgezogen
// (`features/auth/actions.ts`).
//
// Ohne Mailversand zeigt die Oberfläche den Link zum Kopieren. Sobald es Mail
// gibt, verschickt sie dieselbe URL — die Tabelle bleibt, wie sie ist.
//
// Ein Projekt-Gast hat keine Workspace-Mitgliedschaft. Für den gilt dieselbe
// Zeile: `workspaceId` sagt nur, wo die Einladung herkam.

model Invitation {
  token       String    @id
  workspaceId String
  userId      String
  /// Projekt, aus dem die Einladung kam — Ziel des Sprungs nach der Annahme.
  projectId   String?
  /// Wer eingeladen hat — für die Übersicht offener Einladungen ("eingeladen
  /// von"). `null` bei Zeilen von vor dieser Spalte; kein Backfill nötig, die
  /// Übersicht zeigt dafür "Unbekannt".
  invitedById String?
  createdAt   DateTime  @default(now())
  expires     DateTime
  /// Gesetzt, sobald der Zugang eingerichtet wurde. Danach ist der Token tot.
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invitedBy User?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([userId, workspaceId])
  @@index([workspaceId])
}

/// Ein teilbarer Einladungslink: eine feste Rolle, unbegrenzt viele
/// Einlösungen, bis er abläuft oder widerrufen wird. Bewusst getrennt von
/// `Invitation` — die ist "1 Token → 1 vorab angelegtes Konto", das hier ist
/// "1 Token → viele Einlösungen, keine vorab bekannte Identität". Kein
/// `maxUses`/`useCount` in v1: unbegrenzt bis Ablauf/Widerruf ist der
/// einfachste Fall, ein Zähler ist eine rein additive Migration, falls später
/// gebraucht.
model InviteLink {
  token       String    @id
  workspaceId String
  /// `null` = Workspace-weiter Link. Gesetzt = auf ein Projekt beschränkt
  /// (Rolle kann auch die Projekt-Gast-Rolle sein, dann ohne
  /// Workspace-Mitgliedschaft — dieselbe Fallunterscheidung wie bei
  /// `inviteOneProjectMember`).
  projectId   String?
  roleId      String
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  /// Gesetzt heißt: nicht mehr einlösbar, unabhängig von `expiresAt`.
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteLinkCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
}

// ─── Global config (shared across workspaces via join tables) ─────────────────

model Status {
  id       String  @id
  name     String
  short    String
  color    String
  isColumn Boolean @default(true)
  position Int

  workspaces WorkspaceStatus[]
}

model WorkspaceStatus {
  workspaceId String
  statusId    String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status    Status    @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@id([workspaceId, statusId])
}

model Priority {
  id       Int    @id
  key      String @unique
  name     String
  color    String
  position Int

  workspaces WorkspacePriority[]
}

model WorkspacePriority {
  workspaceId String
  priorityId  Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priority  Priority  @relation(fields: [priorityId], references: [id], onDelete: Cascade)

  @@id([workspaceId, priorityId])
}

model IssueType {
  id       String @id
  name     String
  color    String
  position Int

  workspaces WorkspaceIssueType[]
}

model WorkspaceIssueType {
  workspaceId String
  issueTypeId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issueType IssueType @relation(fields: [issueTypeId], references: [id], onDelete: Cascade)

  @@id([workspaceId, issueTypeId])
}

// ─── Rollen & Permissions (RBAC) ──────────────────────────────────────────────

// `scope` sagt, wo eine Rolle vergeben werden kann. Wem sie gehört, sagen die
// beiden Eigentümerspalten — und die sind bei den Default-Rollen leer:
//
//   system  scope        workspaceId  projectId   Bedeutung
//   ──────────────────────────────────────────────────────────────────────────
//   true    (jeder)      null         null        Default-Rolle, existiert
//                                                 GENAU EINMAL für alle
//   false   PLATFORM     null         null        eigene Plattform-Rolle
//   false   WORKSPACE    <ws>         null        eigene Rolle dieses Workspace
//   false   PROJECT      <ws>         null        eigene Rolle, in allen
//                                                 Projekten des Workspace
//   false   PROJECT      <ws>         <p>         eigene Rolle, nur in diesem
//                                                 Projekt
//
// System-Rollen sind nicht editierbar: sie werden von allen Mandanten geteilt,
// eine Änderung träfe also jeden. Wer eine Abwandlung braucht, legt eine eigene
// Rolle an.
//
// `key` ist die stabile, code-referenzierbare ID. Die Eindeutigkeit von (Scope,
// Eigentümer, key) sichern partielle Unique-Indizes ab, die in der Migration von
// Hand angelegt werden — ein `@@unique` über nullable Spalten würde in Postgres
// nicht greifen (NULL ist dort von jedem anderen NULL verschieden).
// Nachgeschlagen wird über die deterministisch gebildete `id` (lib/rbac/id.ts).
model Role {
  id          String    @id
  scope       RoleScope
  workspaceId String?
  projectId   String?
  key         String
  name        String
  desc        String    @default("")
  rank        Int       @default(0)
  editable    Boolean   @default(true)
  /// Default-Rolle aus lib/rbac/roles.ts — gehört niemandem, gilt für alle.
  system      Boolean   @default(false)

  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]
  platformUsers    User[]            @relation("UserPlatformRole")
  // Team-Projekt-Verknüpfungen, die diese Rolle verleihen.
  teamProjects     TeamProject[]
  inviteLinks      InviteLink[]

  @@index([scope, workspaceId])
  @@index([projectId])
}

// Permission-Keys sind hardcoded im Code (lib/rbac/permissions.ts). Die Tabelle
// dient als FK-Ziel und dokumentiert die verfügbaren Permissions.
//
// Ein Key nennt nur Objekt und Aktion (`issue.create`, `label.update`) — in
// welchen Scopes er vergeben werden darf, steht in der Registry, nicht hier.
// Dieselbe Permission wirkt in einer Workspace-Rolle workspaceweit und in einer
// Projektrolle nur in diesem Projekt.
model Permission {
  key  String @id
  desc String @default("")

  roles RolePermission[]
}

// Eine Zeile heißt: diese Rolle hat diese Permission. Es gibt keine Gegenrichtung.
//
// Früher stand hier ein `effect` mit ALLOW und DENY. Das war nötig, solange eine
// Prüfung mehrere Rollen vereinigte und ein Recht von oben wieder weggenommen
// werden musste. Seit jeder Kontext genau eine Rolle auflöst (lib/permissions.ts)
// kann eine Rolle pro Permission ohnehin nur eine Zeile haben — ein DENY wäre von
// „keine Zeile" nicht zu unterscheiden gewesen. Ein Verbotsschild, das nichts
// verbietet, ist in einer Rechtetabelle schlimmer als keines.
//
// Kämen einmal Rechte über Teams dazu, würden wieder mehrere Rollen zusammenlaufen
// und ein Verbot bekäme wieder eine Bedeutung. Dann gehört es für diesen Fall neu
// entworfen, statt einen Rest aus einem anderen Modell weiterzuschleppen.
model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

// ─── Labels (workspace-specific) ─────────────────────────────────────────────

model Label {
  id          String  @id
  workspaceId String
  projectId   String?
  name        String
  slug        String
  color       String

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hiddenIn  ProjectHiddenLabel[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([projectId])
}

// Ein Workspace-Label gilt in jedem Projekt. Wo es nicht passt, blendet das
// Projekt es aus: eine Zeile hier heißt „dieses Label steht in diesem Projekt
// nicht mehr zur Auswahl". Das Label selbst bleibt unangetastet — es gehört dem
// Workspace, und in anderen Projekten wird es weiter vergeben.
//
// Ausblenden nimmt es nur aus der Auswahl, nicht von den Aufgaben, die es schon
// tragen: sonst verschwände mit einem Klick eine Einteilung, die jemand bewusst
// gesetzt hat — und zwar unwiederbringlich, denn `Issue.labels` ist ein Array
// ohne Historie. Wieder eingeblendet, ist alles wie zuvor.
//
// Für Projekt-Labels ist die Tabelle ohne Bedeutung: die gelten ohnehin nur in
// ihrem eigenen Projekt, dort wären sie zu löschen statt auszublenden.
model ProjectHiddenLabel {
  projectId String
  labelId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label   Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([projectId, labelId])
  @@index([labelId])
}

/// Wie ein Issue oder Kommentar entstanden ist — für die kleine Quelle-Badge
/// neben Reporter/Autor in der UI (nach dem Vorbild von GitLabs Pipeline-
/// Quellen wie „API"/„Web"). `APP` ist der Normalfall (die eigentliche
/// Web-App) und deshalb der Default — nur `features/api-v1/mutations.ts`
/// setzt `API` oder `MCP` explizit, je nachdem ob der Aufruf über
/// `app/api/v1` oder `app/api/mcp` kam.
enum ContentSource {
  APP
  API
  MCP
}

// ─── Issues ──────────────────────────────────────────────────────────────────

model Issue {
  id       String @id
  key      Int
  title    String
  status   String @default("backlog")
  priority Int    @default(0)

  // ProseMirror-Dokument. Angezeigt wird es von `components/ui/atoms/RichText`,
  // geschrieben von `RichTextEditor`.
  description     Json   @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  // Aus `description` abgeleiteter Fließtext — `contains` arbeitet nicht auf
  // einer Json-Spalte, die Volltextsuche in `getProjectIssues` braucht ihn.
  // Wird in `features/issues/actions.ts` bei jedem Schreibvorgang neu gesetzt.
  descriptionText String @default("")

  /// Generierte tsvector-Spalte für die Postgres-Volltextsuche
  /// (`searchIssueIds` in `features/issues/queries.ts`) — aus `title`
  /// (Gewicht A) und `descriptionText` (Gewicht B), von Postgres bei jedem
  /// INSERT/UPDATE selbst neu berechnet (siehe Migration), kann also nicht
  /// aus dem Tritt geraten wie ein von der App gepflegtes Duplikat.
  searchVector Unsupported("tsvector")?

  type    String   @default("feature")
  labels  String[]
  rank    Float    @default(0)
  created DateTime @default(now())
  updated DateTime @updatedAt

  /// Wann die Aufgabe abgeschlossen wurde — gesetzt, sobald ihr Status auf
  /// „done" oder „canceled" wechselt, und wieder geleert, wenn sie zurück in die
  /// Arbeit geht (`features/issues/actions.ts`).
  ///
  /// Eine eigene Spalte, obwohl `updated` beim Abschließen dasselbe Datum trägt:
  /// `updated` verschiebt sich bei jeder späteren Änderung mit — ein Kommentar,
  /// ein Label, ein Tippfehler im Titel. Das Dashboard misst daran den Durchsatz
  /// und die Durchlaufzeit, und beide wären damit nicht bloß ungenau, sondern
  /// rückwirkend veränderlich.
  closedAt DateTime?

  /// Fälligkeitsdatum (BARY-4) — optional, für Sprint-/Kapazitätsplanung.
  /// Nur der Kalendertag zählt; die Uhrzeit wird beim Setzen auf Mittag UTC
  /// gestempelt (`features/issues/actions.ts`), damit ein Tag nicht je nach
  /// Zeitzone des Betrachters auf den Vor- oder Folgetag rutscht.
  dueDate DateTime?

  /// Aufwandsschätzung (BARY-4) — zwei unabhängige, beide optionale Felder
  /// statt eines gemeinsamen, weil Teams unterschiedlich schätzen und ein
  /// Issue beides gleichzeitig tragen können soll (z. B. Story Points fürs
  /// Sprint-Board, Stunden für die Abrechnung). Kein Bezug zueinander, keine
  /// automatische Umrechnung.
  /// Story Points: ganzzahlig, üblicherweise Fibonacci (1/2/3/5/8/13) —
  /// nicht als Enum/Katalog modelliert, da die Skala nicht pro Workspace
  /// konfigurierbar ist (anders als `priority`/`status`/`type`).
  storyPoints Int?
  /// Zeitschätzung, normalisiert auf Stunden (z. B. 2.5) — die eine
  /// gespeicherte Wahrheit fürs Filtern/Sortieren/Reporting, unabhängig
  /// davon, in welcher Einheit sie eingegeben wurde.
  estimateHours Float?
  /// In welcher Einheit `estimateHours` eingegeben wurde ("hours"/"days"/
  /// "weeks"/"months"/"years", siehe `features/issues/estimate.ts`) — reine
  /// Anzeige-Information für die Rückumrechnung (z. B. "2 Tage" statt "16
  /// Stunden"), verändert `estimateHours` selbst nicht. `null` genau dann,
  /// wenn `estimateHours` auch `null` ist.
  estimateUnit String?

  /// Token für den öffentlichen Lese-Link (`issue.share.manage`). `null` heißt
  /// Teilen aus. Ein Feld statt eines eigenen Modells: es gibt nur einen
  /// aktiven Link pro Issue, kein Verlauf, kein Zähler — genau das, was ein
  /// „an/aus mit Regenerieren"-Schalter braucht, jede Änderung steht zusätzlich
  /// im Audit-Log (`issue.shared`/`issue.share.revoked`).
  shareToken            String?   @unique
  /// Wer/wann des *aktuell aktiven* Links — anders als das Audit-Log (das jede
  /// Änderung für immer behält) nur der jeweils letzte Stand, für die
  /// Anzeige auf `/share/[token]` selbst. Mit `shareToken` zusammen gesetzt
  /// und geleert.
  shareTokenCreatedAt   DateTime?
  shareTokenExpiresAt   DateTime?
  shareTokenCreatedById String?

  assigneeId String?
  reporterId String
  projectId  String

  /// Übergeordnetes Issue für Sub-Issues (BARY-1). `null` = Top-Level.
  /// `onDelete: SetNull` statt Cascade: Löscht man das Elternissue, werden
  /// die Unteraufgaben nicht mitgelöscht, sondern rutschen auf die oberste
  /// Ebene hoch — dieselbe Zurückhaltung wie bei `Comment.parent`, nur ohne
  /// die Kaskade, weil ein Sub-Issue anders als eine Antwort für sich allein
  /// noch Sinn ergibt.
  parentId String?

  /// Wie das Issue entstanden ist (`ContentSource`) — Default `APP`, da nur
  /// die öffentliche API und der MCP-Server (`features/api-v1/mutations.ts`)
  /// hier je nach Aufrufer explizit `API`/`MCP` setzen.
  source ContentSource @default(APP)

  assignee      User?           @relation("IssueAssignee", fields: [assigneeId], references: [id])
  reporter      User            @relation("IssueReporter", fields: [reporterId], references: [id])
  sharedBy      User?           @relation("IssueSharedBy", fields: [shareTokenCreatedById], references: [id], onDelete: SetNull)
  project       Project         @relation(fields: [projectId], references: [id])
  parent        Issue?          @relation("IssueParent", fields: [parentId], references: [id], onDelete: SetNull)
  subIssues     Issue[]         @relation("IssueParent")
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]
  /// Beziehungen, bei denen dieses Issue die Quelle ist — z. B. "blockiert
  /// X" (siehe `IssueRelation`).
  relationsFrom IssueRelation[] @relation("IssueRelationSource")
  /// Beziehungen, bei denen dieses Issue das Ziel ist — z. B. "wird von X
  /// blockiert".
  relationsTo   IssueRelation[] @relation("IssueRelationTarget")

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([assigneeId])
  @@index([parentId])
  // Der Durchsatz des Dashboards gruppiert je Projekt über diese Spalte.
  @@index([projectId, closedAt])
  // Für den Fälligkeitsdatum-Filter (BARY-4) — dieselbe Form wie der
  // closedAt-Index oben, nur fürs offene statt fürs abgeschlossene Issue.
  @@index([projectId, dueDate])
  @@index([searchVector], type: Gin)
}

/// Typisierte Beziehung zwischen zwei Issues (BARY-1) — Linear/Jira nennen
/// das "Issue Links". Bei `BLOCKS` und `DUPLICATES` ist die Richtung Teil
/// der Bedeutung ("issue blockiert related", nicht umgekehrt), deshalb zwei
/// benannte Enden statt eines symmetrischen Paars. `RELATES_TO` hat keine
/// Richtung — dort legt `addIssueRelation` (`features/issues/actions.ts`)
/// `issueId`/`relatedId` kanonisch nach ID-Sortierung an, damit "A relates B"
/// und "B relates A" nicht als zwei Zeilen enden.
enum IssueRelationType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

model IssueRelation {
  id      String            @id
  type    IssueRelationType
  created DateTime          @default(now())

  issueId   String
  relatedId String

  issue   Issue @relation("IssueRelationSource", fields: [issueId], references: [id], onDelete: Cascade)
  related Issue @relation("IssueRelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([issueId, relatedId, type])
  @@index([relatedId])
}

// ─── Comments ────────────────────────────────────────────────────────────────

model Comment {
  id       String    @id
  // Wie `Issue.description`: ProseMirror-Dokument plus abgeleiteter Fließtext
  // für Vorschauen (Inbox) und spätere Suche.
  body     Json
  bodyText String    @default("")
  /// Wie `Issue.searchVector`, aus `bodyText` — lässt `searchIssueIds` auch
  /// über Kommentare hinweg treffen, nicht nur über Titel/Beschreibung.
  searchVector Unsupported("tsvector")?
  created  DateTime  @default(now())
  /// `null` = nie bearbeitet — steuert den „bearbeitet"-Hinweis in der UI.
  updated  DateTime?

  issueId  String
  authorId String
  /// Selbstbezug für echtes, beliebig tiefes Threading. `null` = Top-Level.
  parentId String?
  /// Wie der Kommentar entstanden ist (`ContentSource`) — siehe `Issue.source`.
  source   ContentSource @default(APP)

  issue     Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id])
  /// Löscht man den Elternkommentar, verlieren seine Antworten ihren Sinn —
  /// dieselbe Kaskade wie `Comment.issue`, nur eine Ebene tiefer, und wirkt
  /// über beliebig viele Ebenen: Postgres wertet die Fremdschlüssel-Kaskade
  /// je Zeile aus, das Löschen einer Antwort löst also seinerseits die
  /// Kaskade für ihre eigenen Antworten aus.
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([searchVector], type: Gin)
}

/// Eine Zeile je Person, Kommentar und Emoji — `@@unique` verhindert doppelte
/// Reaktionen und ist zugleich der Konfliktpunkt, über den `toggleCommentReaction`
/// (`features/issues/actions.ts`) das Umschalten race-sicher per
/// „erst erstellen, bei Konflikt löschen" statt einer vorherigen Abfrage löst.
model CommentReaction {
  id        String   @id
  commentId String
  userId    String
  emoji     String
  created   DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  // Kein `onDelete: Cascade` hier — konsistent mit `Comment.author`, das
  // ebenfalls keins trägt. Ein Konto wird ohnehin stillgelegt statt gelöscht
  // (`User.deactivatedAt`).
  user    User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId, emoji])
}

// ─── Anhänge ─────────────────────────────────────────────────────────────────
//
// Ein Anhang ist entweder ein hochgeladener Datei-Anhang (`kind = "file"`,
// Objekt im `issues`-Bucket unter `key`) oder ein reiner Link (`kind = "link"`,
// externe Adresse in `url`, kein Upload) — genau die zwei Reiter der
// Segmentkontrolle in der Anhänge-Sektion. Eine Zeile kann zusätzlich aus der
// Beschreibung heraus verlinkt sein (`attachment`-Knoten im ProseMirror-Doc,
// der nur die `id` trägt, siehe `lib/richtext/attachments.ts`) — das ist
// dieselbe Zeile, kein Duplikat.
model Attachment {
  id       String   @id
  /// "file" oder "link".
  kind     String
  name     String
  /// S3-Objektschlüssel im `issues`-Bucket — nur bei kind="file".
  key      String?
  /// Externe Adresse — nur bei kind="link".
  url      String?
  mimeType String?
  size     Int?
  created  DateTime @default(now())

  issueId  String
  authorId String

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}

// ─── Benachrichtigungen ─────────────────────────────────────────────────────
//
// Eine Zeile je Empfänger und Anlass — Anlässe stehen in `NOTIFICATION_EVENTS`
// (`features/account/types.ts`), gegen `UserPreferences.{type}InApp` geprüft,
// bevor die Zeile überhaupt entsteht (`lib/notify`). `projectId` trennt
// Workspace- von Projekt-Ereignissen: gesetzt heißt projekt-, `null`
// workspace-bezogen — genau die Grenze, an der die Inbox filtert.
//
// `actorLabel` ist wie `AuditLog.actorLabel` zur Schreibzeit eingefroren: wer
// später sein Konto umbenennt oder verliert, verändert damit nicht rückwirkend,
// was in einer schon zugestellten Benachrichtigung steht.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// Schlüssel aus `NOTIFICATION_EVENTS` — assigned, mentioned, comment,
  /// commentReply, status, invite, role, issueShared.
  type      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  workspaceId String
  /// Gesetzt = projekt-bezogen, `null` = workspace-bezogen.
  projectId   String?
  issueId     String?

  actorId    String?
  actorLabel String  @default("")
  /// Zusatztext je nach `type`: Rollenname (role/invite), Statuskey (status)
  /// oder Kommentar-Vorschau (comment/commentReply/mentioned).
  text       String  @default("")

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, projectId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

// ─── Teams ───────────────────────────────────────────────────────────────────

model Team {
  id          String @id
  workspaceId String
  name        String
  key         String
  color       String
  desc        String @default("")

  leadId String
  lead   User   @relation("TeamLead", fields: [leadId], references: [id])

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  projects       TeamProject[]
  // Zeilen, deren Rolle zuletzt von diesem Team begründet wurde (Anzeige,
  // siehe `ProjectMember.originTeam`).
  grantedMembers ProjectMember[]

  @@unique([workspaceId, key])
}

model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

/// Verknüpft ein Team mit einem Projekt — zur Gruppierung (offene Aufgaben in
/// der Team-Übersicht) und optional mit einer Rolle, die das Team dort
/// verleiht.
///
/// `roleId` ist bewusst nullable: ein Team lässt sich weiterhin ohne Rolle an
/// ein Projekt hängen, rein zur Zuordnung, ohne dass seine Mitglieder dadurch
/// Zugriff bekommen. Erst eine gesetzte Rolle lässt `syncProjectTeamRoles`
/// (`lib/project-membership.ts`) `ProjectMember`-Zeilen für die Mitglieder
/// nachziehen.
model TeamProject {
  teamId    String
  projectId String
  roleId    String?

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict wie bei ProjectMember: eine Rolle, die noch ein Team trägt, lässt
  // sich nicht löschen.
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([teamId, projectId])
  @@index([roleId])
}

// ─── Audit-Log ────────────────────────────────────────────────────────────────
//
// Was auf der Plattform geschehen ist, in der Reihenfolge, in der es geschah:
// Anmeldungen, Rollenwechsel, Stilllegungen, Löschungen — und jeder
// Notfall-Zugriff auf ein Projekt (`lib/audit.ts`).
//
// **Diese Tabelle hat mit Absicht keine Fremdschlüssel.** Ein Protokoll, das
// mitgelöscht wird, wenn jemand das Konto löscht, über dessen Tat es berichtet,
// ist kein Protokoll. Deshalb stehen hier nur nackte Ids — und daneben die
// Beschriftungen, wie sie zur Tatzeit galten. Wer den Namen von heute sehen
// will, schlägt ihn über die Id nach; wer wissen will, was damals auf dem
// Bildschirm stand, liest das Label.
//
// Geschrieben wird nur, nie geändert und nie gelöscht. Es gibt dafür keine
// Server Action — `recordAudit()` ist der einzige Weg hinein.

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Schlüssel aus `AUDIT_ACTIONS` (lib/audit.ts) — z. B. `auth.login`.
  action String

  /// Wer gehandelt hat. Null bei einem fehlgeschlagenen Anmeldeversuch, bei dem
  /// niemand feststeht.
  actorId    String?
  /// Name und Adresse zur Tatzeit, damit die Zeile für sich lesbar bleibt.
  actorLabel String
  /// Kontofarbe zur Tatzeit, für den Avatar in der Liste — genau wie
  /// `actorLabel` eingefroren, nicht bei jedem Lesen neu aufgelöst. Null ohne
  /// `actorId` (fehlgeschlagene Anmeldung) oder bei einem gelöschten Konto.
  actorColor String?

  /// Woran gehandelt wurde. Frei gehalten (`user`, `project`, `workspace`,
  /// `role`), damit eine neue Objektart keine neue Spalte braucht.
  targetType  String?
  targetId    String?
  targetLabel String?

  /// Kontofarbe der Person, um die es in `targetLabel` geht, wenn das Ziel
  /// selbst keine Person ist (z. B. „Issue MOB-5 an Camila Santos zugewiesen" —
  /// Ziel ist das Issue, nicht Camila). Eingefroren wie `actorColor`. Bei
  /// Zielen, die schon selbst eine Person sind, bleibt sie leer — dort steht
  /// die Auskunft im Namen (`actorLabel`-Pendant gibt es dafür nicht, das Ziel
  /// braucht keinen zweiten Namen).
  personColor String?

  /// Wo es geschah — für die Einordnung, nicht für einen Join.
  workspaceId String?
  projectId   String?

  /// Die Begründung, die beim Notfall-Zugriff verlangt wird. Sonst leer.
  reason String?

  /// Was sonst noch zur Tat gehört (alte und neue Rolle etwa). Bewusst formfrei:
  /// das Protokoll soll nicht bei jedem neuen Vorgang wandern müssen.
  meta Json?

  /// Die Liste wird immer nach Zeit gelesen, meist gefiltert nach Vorgang,
  /// Handelndem oder Ort.
  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  /// Für den Aktivitätsverlauf eines einzelnen Issues (`getIssueById`/
  /// `getIssueByRef`, gefiltert auf `targetId`).
  @@index([targetId, createdAt(sort: Desc)])
}

// ─── Mail-Vorlagen (Admin-Override) ────────────────────────────────────────────
//
// Jede Vorlage in `lib/mail/templates/` hat einen Code-Default. Diese Tabelle
// überschreibt davon nur drei Textbausteine — Betreff, Überschrift,
// Einleitungstext — mit `{{platzhalter}}`-Syntax für Namen und Links; siehe
// `MAIL_TEMPLATE_CATALOG` in `features/mail-templates/catalog.ts` für die
// gültigen Schlüssel und Platzhalter je Vorlage. Layout, Detailtabellen und
// der Knopftext bleiben immer Code — eine kaputte Vorlage kann höchstens
// falschen Text zeigen, nie das Layout brechen oder Escaping umgehen.
//
// Fehlt eine Zeile zu einem Schlüssel, gilt der Code-Default unverändert —
// wie bei jeder anderen Einstellung in dieser App mit Vorgabewert.

model MailTemplate {
  /// Aus `MAIL_TEMPLATE_KEYS`, z. B. `invitation` oder `notification.assigned`.
  key String @id

  subject  String
  heading  String
  bodyText String

  updatedAt DateTime @updatedAt
}

// ─── Plattformweite Einstellungen (Singleton) ──────────────────────────────
//
// Genau eine Zeile, immer mit `id = 1` — gelesen über
// `findUnique({ where: { id: 1 } })`, geschrieben über `upsert` auf dieselbe
// Id (`lib/system-settings.ts`, `features/system-settings/actions.ts`).
// Fehlt die Zeile (frische Installation), gelten die Spalten-Defaults, genau
// wie bei `MailTemplate` ohne Override — es gibt deshalb auch keinen
// Seed-Eintrag dafür.
model SystemSettings {
  id Int @id @default(1)

  /// Aus, heißt: niemand kann mehr über `/create-workspace`, die REST-API
  /// oder das MCP-Tool einen neuen Workspace anlegen — nur noch
  /// `defaultWorkspace` nimmt neue Konten auf. Mit `defaultWorkspaceId`
  /// zusammen ausgewertet in `lib/system-settings.ts#canCreateWorkspace`:
  /// solange kein Default gesetzt ist, bleibt das Anlegen faktisch offen,
  /// damit niemand sich selbst aussperrt.
  allowWorkspaceCreation Boolean @default(true)

  /// Wohin ein Konto ohne Workspace-Mitgliedschaft kommt, wenn
  /// `allowWorkspaceCreation` aus ist (`app/[locale]/page.tsx`). `SetNull`
  /// beim Löschen des Workspace, statt die Löschung zu blockieren — dann
  /// gilt wieder "kein Default gesetzt", nicht "Löschen verboten".
  defaultWorkspaceId String?
  defaultWorkspace   Workspace? @relation(fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)

  /// Erlaubt Plugins, die aus keinem Store kommen (Upload, Verzeichnis, von Hand
  /// eingegebene Repository-Adresse). Aus (Standard): solche Plugins werden nicht
  /// geladen. An: eines ohne Code läuft; eines mit Code bleibt blockiert, weil
  /// ungeprüfter Code nicht im Prozess der App läuft (`lib/plugins/policy.ts`).
  /// Nur mit `plugin.manage` änderbar und nur nach einer Warnung, die der Server
  /// selbst einfordert (`features/plugin-stores/unsignedActions.ts`). Fehlt die
  /// Zeile oder lässt sich die Einstellung nicht lesen, gilt "aus"
  /// (`lib/plugins/unsigned.ts`).
  allowUnsignedPlugins Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([defaultWorkspaceId])
}

// ─── Plugins ────────────────────────────────────────────────────────────────
//
// Die Plattform installiert (`plugin.manage`), ein Workspace schaltet ein
// (`plugin.enable`). Deshalb zwei Tabellen: `Plugin` gibt es einmal je
// Installation, `PluginWorkspace` einmal je Plugin und Workspace, in dem es
// schon einmal eingeschaltet war. Der Code selbst liegt nicht in der Datenbank,
// sondern im Plugin-Verzeichnis (`<id>/<version>/`, docs/plugins/adr-0001).
//
// Bewusst nicht Teil von v1: eigene Tabellen je Plugin (Plugin-Daten laufen über
// den generischen Storage, BARY-85) und ein Opt-out je Projekt (kommt mit dem
// Slot-Framework, BARY-65, das es als Erstes braucht).

/// Woher ein installiertes Plugin stammt. `STORE`: aus einem Plugin-Store, der
/// gepinnte Hash steht im Store-Eintrag. `UPLOAD` und `DIRECTORY`: ohne
/// Store-Eintrag; solche Plugins laden nur, wenn die Plattform unsignierte
/// Plugins erlaubt (BARY-110).
enum PluginSource {
  STORE
  UPLOAD
  DIRECTORY
}

/// Wo ein Plugin gilt (das `scope` aus dem Manifest). `WORKSPACE`: die Plattform
/// installiert, ein Workspace schaltet es ein (`plugin.enable`), gespeichert in
/// `PluginWorkspace`. `PLATFORM`: gilt für die ganze Instanz, sobald es
/// installiert und `ENABLED` ist; es gibt keinen Schalter je Workspace, und nur
/// die Plattform (`plugin.manage`) stellt es ein (`Plugin.config`).
enum PluginScope {
  WORKSPACE
  PLATFORM
}

/// Schalter der Plattform für das ganze Plugin, unabhängig von den Workspaces.
/// `DISABLED` lädt es nicht mehr, ohne es zu deinstallieren; die Einstellungen
/// der Workspaces bleiben dabei erhalten.
enum PluginStatus {
  ENABLED
  DISABLED
}

/// Ein auf der Plattform installiertes Plugin.
///
/// Ob es *lädt*, steht hier nicht: das entscheidet beim Start die Prüfung in
/// `lib/plugins/resolve.ts` (passende Barynt-Version, Abhängigkeiten) und wird
/// nicht gespeichert, damit ein Host-Upgrade nichts nachziehen muss.
model Plugin {
  /// Die `id` aus dem Manifest, zugleich Verzeichnisname. Der Primärschlüssel
  /// ist die Id selbst: zwei Plugins mit derselben Id kann es nicht geben, und
  /// Pfade, Berechtigungen und Routen leiten sich von ihr ab.
  id      String @id
  /// Die installierte Version (SemVer, ohne Build-Metadaten). Es liegt immer nur
  /// eine Version installiert; ein Update ersetzt sie.
  version String

  status PluginStatus @default(ENABLED)
  source PluginSource

  /// Aus dem Manifest beim Installieren und bei jedem Update übernommen, damit
  /// "welche Plugins gelten in diesem Workspace" eine Abfrage ist und kein
  /// Durchgang über die Manifeste auf der Platte.
  scope PluginScope @default(WORKSPACE)

  /// Die Einstellungen der Plattform für ein `PLATFORM`-Plugin; leer, solange
  /// nichts eingestellt wurde, und bei `WORKSPACE`-Plugins ungenutzt (deren
  /// Einstellungen stehen je Workspace in `PluginWorkspace.config`).
  config Json @default("{}")

  /// Bei `STORE` die Adresse des Stores (der offizielle oder ein eigener), aus
  /// dem es kam. Sonst leer.
  origin String?

  /// Hash des Plugin-*Verzeichnisses* im Format `sha512-<base64>`, bei der
  /// Installation von `hashPluginDirectory()` berechnet und vom Admin freigegeben.
  /// Vor jedem Laden geprüft (`lib/plugins/integrity.ts`): passen die Dateien
  /// nicht dazu, lädt das Plugin nicht. Den im Store-Eintrag gepinnten Hash des
  /// Release-Archivs prüft der Installer vor dem Entpacken; gespeichert wird der
  /// Verzeichnis-Hash.
  integrity String

  /// Der Hash, für den die Plattform ausdrücklich freigegeben hat, dass der Code
  /// dieses Plugins im Prozess der App läuft (`features/plugins/actions.ts`,
  /// `plugin.manage`). Leer: nicht freigegeben, ein Plugin mit `server` oder
  /// `client` läuft dann nicht. Immer je Plugin und je Hash, nie für einen Store
  /// als Ganzes. Passt er nicht mehr zu `integrity` (nach einem Update), läuft der
  /// Code nicht, bis die neue Version freigegeben ist (`approval-outdated` in
  /// `lib/plugins/policy.ts`). Ein Plugin ohne Code braucht keine Freigabe.
  codeApprovalHash String?

  /// Wann die Freigabe erteilt wurde. Gesetzt und gelöscht zusammen mit
  /// `codeApprovalHash`. Wer sie erteilt hat, steht im Audit-Protokoll.
  codeApprovedAt DateTime?

  installedAt DateTime @default(now())
  /// Ändert sich bei jedem Update, jedem Umschalten von `status` und jeder
  /// Änderung von `config`.
  updatedAt   DateTime @updatedAt

  workspaces PluginWorkspace[]
}

/// Ein Plugin in einem Workspace: ob es dort eingeschaltet ist und wie es dort
/// eingestellt ist. Die Zeile entsteht beim ersten Einschalten und bleibt beim
/// Ausschalten bestehen, damit die Einstellungen nicht verloren gehen. Nur für
/// Plugins mit `scope = WORKSPACE`: ein Plattform-Plugin gilt überall und hat
/// hier keine Zeilen.
model PluginWorkspace {
  pluginId    String
  workspaceId String

  enabled Boolean @default(true)

  /// Die Einstellungen des Plugins in diesem Workspace. Ihre Form legt das
  /// Plugin selbst fest (BARY-66); leer, solange nichts eingestellt wurde.
  config Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mit dem Deinstallieren des Plugins fallen auch seine Einstellungen weg.
  plugin    Plugin    @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([pluginId, workspaceId])
  /// Für "welche Plugins sind in diesem Workspace eingeschaltet", die häufigste
  /// Frage (jede Seite, die Slots rendert).
  @@index([workspaceId])
}

/// Ein Plugin-Store, den der Admin eingeschaltet oder eingetragen hat (BARY-112).
///
/// Es gibt einen Hauptstore, das Store-Repository des Projekts, das der
/// Bootstrap (`prisma/bootstrap.ts`) einträgt und das standardmäßig an ist. Der
/// Admin kann ihn ausschalten, weitere Stores anbinden oder nur eigene verwenden.
/// Die eingeschalteten Stores sind die Liste, die die Richtlinie bekommt
/// (`lib/plugins/policy.ts`, `lib/plugins/stores.ts`): Code aus einem Store, der
/// hier fehlt oder aus ist, läuft nicht im Prozess. Einen Store einzuschalten
/// gibt selbst nichts frei; jedes Plugin mit Code braucht weiter seine eigene
/// Freigabe (BARY-122).
///
/// Zweig und Sync-Stand kommen mit dem Store-Client (BARY-105, BARY-111), nicht
/// hierher.
model PluginStore {
  id String @id @default(cuid())

  /// Die Adresse, wie sie eingetragen wurde: ein einfaches `https://host/pfad`
  /// (`normalizeStoreUrl()` lehnt alles andere ab). Daraus wird geklont.
  url String

  /// Die Adresse in einheitlicher Form (klein geschrieben, ohne `.git` und
  /// Schrägstrich am Ende). Eindeutig: derselbe Store steht nur einmal da, auch
  /// wenn er einmal mit und einmal ohne `.git` eingegeben wird.
  key String @unique

  name String

  /// Der Hauptstore des Projekts. Er lässt sich ausschalten, aber weder löschen
  /// noch anders eintragen.
  official Boolean @default(false)

  /// Eingeschaltet: Plugins daraus dürfen freigegeben werden und laufen. Aus: der
  /// Store steht nicht in der Liste, die die Richtlinie bekommt.
  enabled Boolean @default(true)

  /// Das Zugangs-Token für ein privates Repository, versiegelt
  /// (`lib/secrets.ts`, AES-256-GCM) und an die Adresse `key` gebunden: ein Wert,
  /// der in eine andere Zeile kopiert wird, lässt sich dort nicht öffnen. Nie im
  /// Klartext, nie in einer Antwort an den Browser, nie in einem Log und nicht im
  /// Audit-Eintrag. Null: das Repository ist öffentlich. Wird nur über
  /// `features/plugin-stores/actions.ts` geschrieben.
  credential String?

  /// Der Benutzername dazu, falls der Hoster einen verlangt (Bitbucket, Azure
  /// DevOps). Kein Geheimnis. Nur sinnvoll, wenn `credential` gesetzt ist.
  credentialUser String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
